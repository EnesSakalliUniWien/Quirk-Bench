{
  "name": "quirk-bench",
  "type": "module",
  "description": "An interactive workbench for constructing, simulating, and inspecting quantum circuits.",
  "license": "Apache-2.0",
  "version": "2.3.2",
  "engines": {
    "node": ">=24.21.0"
  },
  "homepage": "https://github.com/EnesSakalliUniWien/Quirk-Bench",
  "bugs": {
    "url": "https://github.com/EnesSakalliUniWien/Quirk-Bench/issues"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "knip": "^6.42.0",
    "patch-package": "8.0.1",
    "prettier": "^3.9.10",
    "puppeteer": "25.14.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4"
  },
  "scripts": {
    "dev": "vite --open /",
    "build": "vite build",
    "preview": "vite preview --open /",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm test && npm run test:e2e && npm run test:a11y && npm run test:perf",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p jsconfig.types.json",
    "knip": "knip",
    "test:build": "vite build --mode test",
    "test": "npm run test:build && node scripts/run-browser-tests.js test/test.html",
    "test:e2e": "npm run build && node scripts/run-e2e-tests.js",
    "test:perf:build": "vite build --mode perf",
    "test:perf": "npm run test:perf:build && node scripts/run-browser-tests.js test_perf/test_perf.html",
    "screenshot": "npm run build && node scripts/screenshot-circuit.js",
    "postinstall": "patch-package --error-on-fail",
    "lint:ui": "eslint src --max-warnings 0",
    "format": "prettier --write",
    "format:check": "prettier --check .",
    "test:a11y": "npm run build && node scripts/run-accessibility-tests.js",
    "typecheck:legacy": "tsc -p jsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EnesSakalliUniWien/Quirk-Bench.git"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@pixi/react": "8.0.5",
    "@use-gesture/react": "^10.3.1",
    "dockview-react": "^8.6.0",
    "gl-matrix": "^3.4.4",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "mathlive": "0.111.1",
    "pixi.js": "8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "seedrandom": "^3.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
